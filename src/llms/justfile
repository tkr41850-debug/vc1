port := env_var_or_default("ZEN_GATEWAY_PORT", "8789")
pidfile := "/tmp/llms.pid"
logfile := "/tmp/llms.log"

default:
    @just --list

local *args:
    #!/usr/bin/env bash
    set -u
    here="."
    cd "$here" && uv run python scripts/local_call.py {{args}}

web-install:
    #!/usr/bin/env bash
    set -u
    root="../.."
    web="$root/web/llms"
    marker="$web/node_modules/.llms-lock.sha"
    want="$(sha256sum "$web/package-lock.json" | cut -d' ' -f1)"
    if [ -d "$web/node_modules" ] && [ -f "$marker" ] && [ "$(cat "$marker")" = "$want" ]; then
        echo "web-install: node_modules matches lockfile, skipping npm ci"
        exit 0
    fi
    npm ci --prefix "$web"
    sha256sum "$web/package-lock.json" | cut -d' ' -f1 > "$marker"

web-build: web-install
    #!/usr/bin/env bash
    set -u
    root="../.."
    web="$root/web/llms"
    out="$root/src/llms/llms/proxy/static/index.html"
    if [ -f "$out" ] && [ -z "$(find "$web/src" "$web/index.html" "$web/package.json" "$web/package-lock.json" "$web/tsconfig.json" "$web/vite.config.ts" -newer "$out" 2>/dev/null)" ]; then
        echo "web-build: static UI newer than sources, skipping tsc+vite"
        ls "$out"
        exit 0
    fi
    npm run build --prefix "$web"
    ls "$out"

up: web-build
    #!/usr/bin/env bash
    set -u
    root="../.."
    if [ ! -f "$root/.env" ]; then echo "missing $root/.env (copy .env.example)"; exit 1; fi
    set -a; source "$root/.env"; set +a
    export DATA_DIR="$root/data"
    echo "aliases: ${MODEL_ALIASES:-none}"
    echo "data: $DATA_DIR"
    if [ -f {{pidfile}} ] && kill -0 "$(cat {{pidfile}})" 2>/dev/null; then kill "$(cat {{pidfile}})"; sleep 1; fi
    pkill -f "uvicorn llms.proxy.main" 2>/dev/null || true; sleep 1
    cd "$root/src/llms"
    nohup uv run uvicorn llms.proxy.main:app --host 127.0.0.1 --port {{port}} > {{logfile}} 2>&1 < /dev/null & echo $! > {{pidfile}}
    for i in $(seq 1 30); do curl -s --max-time 2 http://127.0.0.1:{{port}}/healthz | grep -q ok && break; sleep 1; done
    curl -s --max-time 5 http://127.0.0.1:{{port}}/healthz; echo

down:
    #!/usr/bin/env bash
    if [ -f {{pidfile}} ]; then kill "$(cat {{pidfile}})" 2>/dev/null || true; rm -f {{pidfile}}; fi
    pkill -f "uvicorn llms.proxy.main" 2>/dev/null || true
    echo stopped

sync:
    #!/usr/bin/env bash
    set -u
    here="."
    cd "$here" && uv sync --group dev

dev:
    #!/usr/bin/env bash
    set -u
    root="../.."
    export DATA_DIR="$root/data"
    cd "$root/src/llms" && uv run uvicorn llms.proxy.main:app --host 127.0.0.1 --port 8789


# Copy to .env and fill in. `just up` / `just docker-up` load it automatically.
# The gateway itself reads these from the environment (no extra wiring needed).

# Operator Zen key; empty = anonymous free tier.
ZEN_API_KEY=
# Port for the gateway + admin UI (same port).
ZEN_GATEWAY_PORT=8789

# Opt-in model aliases to stabilize clients on free models:
# comma-separated pattern=target pairs, e.g. "gpt-*=muse-spark-1.3-free,claude-*=muse-spark-1.3-free".
# A pattern ending in * is a prefix match, otherwise an exact (case-insensitive) match.
# Aliases rewrite the requested model id before routing/bucketing/usage.
MODEL_ALIASES=

# GitHub OAuth app for the admin UI (register at
# https://github.com/settings/developers; Authorization callback URL must be
# ${GITHUB_REDIRECT_URI} below).
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:8789/api/admin/callback
# Comma-separated GitHub logins allowed into /api/admin/* and the UI.
ADMIN_GITHUB_USERS=
# Random secret for signing admin session cookies (generate with: openssl rand -hex 32).
ADMIN_SESSION_SECRET=change-me

# Gateway data dir: YAML store + usage.json. Compose mounts ./data to /data.
DATA_DIR=./data
